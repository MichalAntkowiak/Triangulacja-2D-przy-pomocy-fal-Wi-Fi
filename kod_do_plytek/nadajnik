#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>

// Adres rozgłoszeniowy (Broadcast) do wysyłania pakietów ESP-NOW
uint8_t broadcastAddress[] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};

void setup() {
  Serial.begin(115200);
  
  // Konfiguracja Wi-Fi w trybie Station
  WiFi.mode(WIFI_STA);
  
  // Wymuszenie uruchomienia radia i zablokowanie kanału 1
  esp_wifi_start();
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
  
  // Inicjalizacja protokołu ESP-NOW
  if (esp_now_init() != ESP_OK) {
    Serial.println("Blad podczas inicjalizacji ESP-NOW");
    return;
  }
  
  // Rejestracja urządzenia odbiorczego (rozgłoszeniowego)
  esp_now_peer_info_t peerInfo;
  memcpy(peerInfo.peer_addr, broadcastAddress, 6);
  peerInfo.channel = 1;  
  peerInfo.encrypt = false;
  
  if (esp_now_add_peer(&peerInfo) != ESP_OK){
    Serial.println("Nie udalo sie dodac peera");
    return;
  }
}

void loop() {
  // Wysyłanie minimalnej ramki testowej w celu wyzwolenia pomiaru CSI
  uint8_t dummy_payload = 0;
  esp_now_send(broadcastAddress, &dummy_payload, sizeof(dummy_payload));
  
  // Interwał wysyłania pakietów (~100 Hz)
  delay(10); 
}
